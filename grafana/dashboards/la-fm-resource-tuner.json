     "expr": "demo_scenario_variant{scenario=\"resource-tuner\"}",
     "legendFormat": "{{scenario}}",
     "range": true,
     "instant": false,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
