    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Per sampled workflow (from history)",
   "description": "The runner fetches the history of a sample of completed workflows and counts events. A heartbeat is a WorkflowTaskCompleted followed directly by WorkflowTaskScheduled.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (policy) (rate(demo_history_events_total{policy=~\"heartbeat_.*\",kind=\"wft_heartbeat\"}[1m])) / sum by (policy) (rate(demo_history_sampled_total{policy=~\"heartbeat_.*\"}[1m]))",
     "legendFormat": "workflow task heartbeats \u00b7 {{policy}}",
     "range": true,
     "instant": false,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "sum by (policy) (rate(demo_history_events_total{policy=~\"heartbeat_.*\",kind=\"wft_completed\"}[1m])) / sum by (policy) (rate(demo_history_sampled_total{policy=~\"heartbeat_.*\"}[1m]))",
