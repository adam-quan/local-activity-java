  {
   "type": "timeseries",
   "title": "1 \u00b7 temporal_local_activity_execution_latency p99 (alert > 50% of StartToClose)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, activity_type) (rate(temporal_local_activity_execution_latency_seconds_bucket[30s])))",
     "legendFormat": "p99 {{activity_type}}",
     "range": true,
     "instant": false,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "max(demo_sizing_planned{quantity=\"start_to_close_seconds\"}) * 0.5",
     "legendFormat": "alert: 50% of StartToClose",
     "range": true,
     "instant": false,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
